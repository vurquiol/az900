{
  "name": "az900-cert-practice",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "cross-env NODE_OPTIONS=--openssl-legacy-provider ng serve",
    "start:lan": "cross-env NODE_OPTIONS=--openssl-legacy-provider ng serve --host 0.0.0.0 --disable-host-check",
    "build": "cross-env NODE_OPTIONS=--openssl-legacy-provider ng build",
    "test": "cross-env NODE_OPTIONS=--openssl-legacy-provider ng test",
    "lint": "ng lint",
    "e2e": "cross-env NODE_OPTIONS=--openssl-legacy-provider ng e2e",
    "build:gh-pages": "cross-env NODE_OPTIONS=--openssl-legacy-provider ng build --configuration production --base-href /az900/",
    "postbuild:gh-pages": "node -e \"require('fs').copyFileSync('dist/az900-cert-practice/index.html', 'dist/az900-cert-practice/404.html')\"",
    "deploy": "npm run build:gh-pages && npm run postbuild:gh-pages && npx angular-cli-ghpages --dir=dist/az900-cert-practice"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^15.2.10",
    "@angular/common": "^15.2.10",
    "@angular/compiler": "^15.2.10",
    "@angular/core": "^15.2.10",
    "@angular/forms": "^15.2.10",
    "@angular/platform-browser": "^15.2.10",
    "@angular/platform-browser-dynamic": "^15.2.10",
    "@angular/router": "^15.2.10",
    "rxjs": "~6.6.0",
    "tslib": "^2.0.0",
    "zone.js": "~0.11.4"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^15.2.11",
    "@angular/cli": "^15.2.11",
    "@angular/compiler-cli": "^15.2.10",
    "@types/jasmine": "~3.6.0",
    "@types/jasminewd2": "~2.0.3",
    "@types/node": "^12.11.1",
    "angular-cli-ghpages": "^0.6.2",
    "codelyzer": "^6.0.0",
    "cross-env": "^10.1.0",
    "jasmine-core": "~3.6.0",
    "jasmine-spec-reporter": "~5.0.0",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.1.0",
    "karma-coverage-istanbul-reporter": "~3.0.2",
    "karma-jasmine": "~4.0.0",
    "karma-jasmine-html-reporter": "^1.5.0",
    "protractor": "~7.0.0",
    "ts-node": "~8.3.0",
    "tslint": "~6.1.0",
    "typescript": "~4.9.5"
  }
}